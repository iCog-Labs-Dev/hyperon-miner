!(import! &self (library lib_import))
!(git-import! "https://github.com/eyobderese/hyperon-miner.git")
!(import! &self (library hyperon-miner lib_pattern_miner))
!(add-atom &observations (Likes alice tea))
!(add-atom &observations (Likes bob tea))
!(add-atom &observations (Likes alice coffee))
!(add-atom &observations (Likes bob coffee))
!(add-atom &observations (Likes cara tea))
!(test (PatternMiner.Mine &frequent &observations 2 0) ())
!(test (> (size-atom (collapse (get-atoms &frequent))) 0) True)
!(test (PatternMiner.MineWith &isurp-scores &observations $initial 2 0 isurp True 0.2 True) ())
!(test (> (size-atom (collapse (get-atoms &isurp-scores))) 0) True)
!(match &isurp-scores (surprisingnessOf $pattern $score) (test (and (>= $score 0) (<= $score 1)) True))
!(match &isurp-scores (surprisingnessOf $pattern $score) (test (isurp $pattern &observations True 0.2) $score))
!(test (PatternMiner.MineWith &isurp_old-scores &observations $initial 2 0 isurp-old True 0.2 True) ())
!(test (> (size-atom (collapse (get-atoms &isurp_old-scores))) 0) True)
!(match &isurp_old-scores (surprisingnessOf $pattern $score) (test (and (>= $score 0) (<= $score 1)) True))
!(match &isurp_old-scores (surprisingnessOf $pattern $score) (test (isurp-old $pattern &observations True) $score))
!(test (PatternMiner.MineWith &jsd-scores &observations $initial 2 0 jsd True 0.2 True) ())
!(test (> (size-atom (collapse (get-atoms &jsd-scores))) 0) True)
!(match &jsd-scores (surprisingnessOf $pattern $score) (test (and (>= $score 0) (<= $score 1)) True))
!(match &jsd-scores (surprisingnessOf $pattern $score) (test (do-jsd (emp-tv $pattern &observations) (do-ji-tv-est &observations $pattern)) $score))
!(println! "LIBRARY-CONSUMER-DONE")
