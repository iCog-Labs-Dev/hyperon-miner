!(add-atom &my-db (Likes alice tea))
!(add-atom &my-db (Likes bob tea))
!(add-atom &my-db (Likes cara coffee))
!(add-atom &scores (sentinel 99))
!(add-atom &cndpspace (sentinel candidates))
!(add-atom &conjspace (sentinel conjunctions))
!(add-atom &subsampled-db (sentinel samples))
!(import! &self (library lib_import))
!(git-import! "https://github.com/eyobderese/hyperon-miner.git")
!(import! &self (library hyperon-miner lib_pattern_miner))
!(test (size-atom (collapse (get-atoms &my-db))) 3)
!(test (collapse (get-atoms &scores)) ((sentinel 99)))
!(test (collapse (get-atoms &cndpspace)) ((sentinel candidates)))
!(test (collapse (get-atoms &conjspace)) ((sentinel conjunctions)))
!(test (collapse (get-atoms &subsampled-db)) ((sentinel samples)))
!(test (PatternMiner.MineWith &results &my-db (Likes $who tea) 2 0 none False 0.2 False) ())
!(println! (PUBLIC-RESULTS (collapse (get-atoms &results))))
!(test (collapse (get-atoms &results)) ((supportOf (Likes $who tea) 2)))
!(add-atom &other-db (Likes dana juice))
!(add-atom &other-db (Likes erin juice))
!(test (PatternMiner.MineWith &second &other-db (Likes $who juice) 2 0 none False 0.2 False) ())
!(test (collapse (get-atoms &second)) ((supportOf (Likes $who juice) 2)))
!(test (collapse (get-atoms &results)) ((supportOf (Likes $who tea) 2)))
!(test (PatternMiner.Mine &empty-results &my-db 999 0) ())
!(test (collapse (get-atoms &empty-results)) ())
!(test (collapse (get-atoms &scores)) ((sentinel 99)))
!(test (collapse (get-atoms &cndpspace)) ((sentinel candidates)))
!(test (collapse (get-atoms &conjspace)) ((sentinel conjunctions)))
!(test (collapse (get-atoms &subsampled-db)) ((sentinel samples)))
!(test (size-atom (collapse (get-atoms &my-db))) 3)
!(test (PatternMiner.MineWith &second &other-db $p 2 0 unknown False 0.2 False) (Error PatternMiner.UnsupportedMode unknown))
;; Append to the same output without clearing caller data.
!(add-atom &results (caller-owned keep))
!(test (PatternMiner.MineWith &results &other-db (Likes $who juice) 2 0 none False 0.2 False) ())
!(test (size-atom (collapse (get-atoms &results))) 3)
!(test (collapse (match &results (caller-owned $x) $x)) (keep))
;; The convenient API performs conjunction expansion and leaves caller globals alone.
!(test (PatternMiner.Mine &pairs &my-db 2 0) ())
!(test (> (size-atom (collapse (get-atoms &pairs))) 0) True)
!(get-atoms &pairs)
!(test (PatternMiner.Mine &other-pairs &other-db 2 0) ())
!(test (> (size-atom (collapse (get-atoms &other-pairs))) 0) True)
!(test (collapse (get-atoms &scores)) ((sentinel 99)))
!(test (collapse (get-atoms &cndpspace)) ((sentinel candidates)))
!(test (collapse (get-atoms &conjspace)) ((sentinel conjunctions)))
;; Revisit the first dataset after mining another one.
!(test (PatternMiner.Mine &pairs-again &my-db 2 0) ())
!(test (collapse (get-atoms &pairs-again)) (collapse (get-atoms &pairs)))
!(test (PatternMiner.Mine &triples &my-db 2 1) ())
!(test (> (size-atom (collapse (get-atoms &triples))) 0) True)
!(get-atoms &triples)
!(test (PatternMiner.Mine &empty-out &empty-input 2 0) ())
!(test (collapse (get-atoms &empty-out)) ())
!(println! "LIBRARY-CONSUMER-DONE")
