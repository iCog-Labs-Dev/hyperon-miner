!(import! &self block_scipy.py)
!(import! &self (library lib_import))
!(git-import! "https://github.com/eyobderese/hyperon-miner.git")
!(import! &self (library hyperon-miner lib_pattern_miner))
!(add-atom &observations (Likes alice tea))
!(add-atom &observations (Likes bob tea))
!(add-atom &observations (Likes cara coffee))
!(test (PatternMiner.MineWith &results &observations (Likes $who tea) 2 0 none False 0.2 False) ())
!(test (collapse (get-atoms &results)) ((supportOf (Likes $who tea) 2)))
!(test (PatternMiner.MineWith &scores &observations $initial 2 0 isurp True 0.2 True) ())
!(test (> (size-atom (collapse (get-atoms &scores))) 0) True)
!(test (PatternMiner.MineWith &old-scores &observations $initial 2 0 isurp-old True 0.2 True) ())
!(test (> (size-atom (collapse (get-atoms &old-scores))) 0) True)
!(test (py-call (block_scipy.loaded)) False)
!(println! "LIBRARY-CONSUMER-DONE")
