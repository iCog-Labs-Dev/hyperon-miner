;; Public PeTTa library. Imports definitions only; no datasets or mining.
!(import! &self experiments/utils/surp-utils/boost_petta.py)
!(import! &self experiments/utils/common-utils)
!(import! &self experiments/utils/index_to_var)
!(import! &self experiments/utils/constants)
!(import! &self experiments/utils/TruthValue)
!(import! &self experiments/utils/surp-utils/partition-metta)
!(import! &self experiments/utils/surp-utils/binomialMetta)
!(import! &self experiments/utils/surp-utils/beta-dist)
!(import! &self experiments/utils/surp-utils/surp-utils)
!(import! &self experiments/utils/sort)
!(import! &self experiments/utils/variable-combinations)
!(import! &self experiments/utils/surp-utils/blk-abstractness)
!(import! &self experiments/utils/remove_useless_clauses)
!(import! &self experiments/utils/surp-utils/eq-prob-petta)
!(import! &self experiments/utils/surp-utils/bs-utils)
!(import! &self experiments/utils/surp-utils/jsd-helper)
!(import! &self experiments/truth-values/est-tv)
!(import! &self experiments/truth-values/emp-tv)
!(import! &self experiments/surprisingness/emp-prob)
!(import! &self experiments/surprisingness/isurp)
!(import! &self experiments/surprisingness/isurp-old)
!(import! &self experiments/surprisingness/jsd)
!(import! &self experiments/frequent-pattern-miner/valuation)
!(import! &self experiments/frequent-pattern-miner/shallow-abstractions)
!(import! &self experiments/frequent-pattern-miner/specialization)
!(import! &self experiments/frequent-pattern-miner/candidate)
!(import! &self experiments/frequent-pattern-miner/conjunction-expansion)
!(import! &self experiments/frequent-pattern-miner/frequent-pattern-miner-generic)
!(import! &self experiments/pattern-miner/pattern-miner)

;; Mine all initial patterns, pairs at depth 0, without scoring.
(= (PatternMiner.Mine $out $db $min-support $depth)
    (PatternMiner.MineWith $out $db $initial $min-support $depth none False 0.2 True))

;; Append results; exhaust the search and return one unit expression.
;; Supported modes: none, isurp, isurp-old, jsd.
(= (PatternMiner.MineWith $out $db $initial $min-support $depth $mode $normalize $ratio $conjunctions)
    (case $mode
      ((none (let $done (collapse (pattern-miner $out $db $initial $min-support $depth none $normalize $ratio $conjunctions)) ()))
       (isurp (let $done (collapse (pattern-miner $out $db $initial $min-support $depth isurp $normalize $ratio $conjunctions)) ()))
       (isurp-old (let $done (collapse (pattern-miner $out $db $initial $min-support $depth isurp-old $normalize $ratio $conjunctions)) ()))
       (jsd (let $done (collapse (pattern-miner $out $db $initial $min-support $depth jsd $normalize $ratio $conjunctions)) ()))
       ($_ (Error PatternMiner.UnsupportedMode $mode)))))
